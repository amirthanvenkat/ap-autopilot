# Copy to .env and fill in. Every setting in common.config.Settings appears
# here. Adding a field there means adding a line here in the same commit.

# ---------------------------------------------------------------- runtime
ENVIRONMENT=local

# Fixtures mode. When true the pipeline runs with no external call of any
# kind, which is how the public demo survives the GCP trial expiring.
REPLAY_FIXTURES=true
FIXTURES_DIR=fixtures

# ---------------------------------------------------------------- matching
# Thresholds, tolerances and severities. An invalid file stops startup.
RULES_PATH=config/rules.yaml

# --------------------------------------------------------------- database
# Use Neon's POOLED endpoint. Cloud Run scales out and the free tier
# connection cap is low, so a direct endpoint fails as random 500s.
# Create the Neon project in Singapore: Cloud Run is pinned to
# asia-southeast1 for Document AI, and a US region adds roughly 230 ms to
# every round trip, which the acceptance path cannot afford.
DATABASE_URL=postgresql+psycopg://user:password@host-pooler.region.neon.tech/ap_autopilot
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=2
DB_STATEMENT_TIMEOUT_MS=5000

# ------------------------------------------------------------ google cloud
GCP_PROJECT_ID=
GCP_LOCATION=asia-southeast1
GCS_BUCKET=
DOCAI_PROCESSOR_ID=

# ----------------------------------------------------------------- pub/sub
PUBSUB_WORK_TOPIC=ingestion-work
PUBSUB_DEADLETTER_SUBSCRIPTION=ingestion-deadletter-sub

# ------------------------------------------- inbound push authentication
# The audience configured on the push subscription, and the service account
# Pub/Sub uses to call. Both are checked before the body is read.
OIDC_AUDIENCE=
OIDC_SERVICE_ACCOUNT=
OIDC_ISSUER=https://accounts.google.com
# Fixtures mode has no network, so it verifies this shared secret instead of
# a Google signed token. The 401 path stays real either way.
OIDC_DEV_TOKEN=change-me-in-local-only

# ------------------------------------------------------------------- gmail
GMAIL_USER_ID=me
GMAIL_LABEL=ap-inbox
# Attachments below this size are skipped. Signature logos arrive as
# attachments, and each one that gets through is a document row and a paid
# Document AI call.
GMAIL_MIN_ATTACHMENT_BYTES=8192

# ------------------------------------------------------------------ upload
MAX_UPLOAD_BYTES=20971520

# --------------------------------------------------------- outbox and jobs
OUTBOX_LEASE_SECONDS=300
OUTBOX_MAX_ATTEMPTS=5
# How long a job may sit RUNNING before the reaper resolves it. A failed
# Document AI operation writes no output, so no finalize event ever fires.
JOB_TIMEOUT_SECONDS=900

# ------------------------------------------------------------ outbound http
HTTP_TIMEOUT_SECONDS=10.0
HTTP_MAX_ATTEMPTS=5
HTTP_FIRST_DELAY_SECONDS=1.0
HTTP_MAX_DELAY_SECONDS=32.0
# The work topic publish sits outside the acceptance transaction and is
# best effort. The outbox row is already committed, so a failed publish
# costs the sweep interval and nothing else.
PUBLISH_TIMEOUT_SECONDS=0.25
